@model IReadOnlyList<TechnifyERP.Application.Assignments.AssignmentDto>
@{ViewData["Title"]="Assignments";}
<div class="d-flex justify-content-between mb-4"><div><h1 class="h2">Assignments</h1><p class="text-secondary">Manage assignments for your assigned courses.</p></div><a asp-action="Create" class="btn btn-primary align-self-start">Create Assignment</a></div>
@if(TempData["SuccessMessage"] is string success){<div class="alert alert-success">@success</div>}
<div class="row g-3">@foreach(var item in Model){<div class="col-lg-6"><div class="card border-0 shadow-sm h-100"><div class="card-body"><span class="badge text-bg-primary">@item.CourseCode</span><h2 class="h5 mt-2">@item.Title</h2><p>@item.Description</p><div>Due: @item.DueAtUtc.ToLocalTime().ToString("dd MMM yyyy hh:mm tt")</div><div>Marks: @item.TotalMarks · Submissions: @item.SubmissionCount</div><div class="d-flex gap-2 mt-3"><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a><a asp-action="Submissions" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Submissions</a><form asp-action="Delete" method="post"><input type="hidden" name="id" value="@item.Id"/><button class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete assignment?')">Delete</button></form></div></div></div></div>}@if(Model.Count==0){<div class="alert alert-info">No assignments have been created.</div>}</div>
