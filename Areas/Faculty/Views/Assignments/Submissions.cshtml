@model IReadOnlyList<TechnifyERP.Application.Assignments.AssignmentSubmissionDto>
@{var assignment=(TechnifyERP.Application.Assignments.AssignmentDto)ViewBag.Assignment;ViewData["Title"]="Submissions";}
<div class="d-flex justify-content-between"><div><h1 class="h2">@assignment.Title</h1><p>Submissions · Total @assignment.TotalMarks marks</p></div><a asp-action="Export" asp-route-id="@assignment.Id" class="btn btn-outline-success align-self-start">Export CSV</a></div>
@if(TempData["SuccessMessage"] is string success){<div class="alert alert-success">@success</div>}@if(TempData["ErrorMessage"] is string error){<div class="alert alert-danger">@error</div>}
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Student</th><th>Submission</th><th>Grade</th></tr></thead><tbody>@if(Model.Count==0){<tr><td colspan="3" class="text-center py-5">No submissions.</td></tr>}@foreach(var item in Model){<tr><td>@item.StudentName<div class="small">@item.RegistrationNumber</div></td><td><a href="@item.FilePath" target="_blank">Download</a><div class="small">Attempt @item.SubmissionNumber</div></td><td><form asp-action="Grade" method="post" class="d-flex gap-2"><input type="hidden" name="assignmentId" value="@assignment.Id"/><input type="hidden" name="submissionId" value="@item.Id"/><input name="marks" type="number" step="0.01" min="0" max="@assignment.TotalMarks" value="@item.Marks" class="form-control form-control-sm" placeholder="Marks"/><input name="feedback" value="@item.Feedback" class="form-control form-control-sm" placeholder="Feedback"/><button class="btn btn-sm btn-primary">Save</button></form></td></tr>}</tbody></table></div></div>
