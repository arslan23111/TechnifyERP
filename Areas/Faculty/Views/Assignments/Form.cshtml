@model TechnifyERP.ViewModels.Faculty.AssignmentFormViewModel
@{ViewData["Title"]=Model.Id==0?"Create Assignment":"Edit Assignment";}
<h1 class="h2">@ViewData["Title"]</h1><form asp-action="Save" method="post" enctype="multipart/form-data" class="card border-0 shadow-sm"><div class="card-body p-4"><input asp-for="Id" type="hidden"/><input asp-for="ExistingAttachmentPath" type="hidden"/><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-md-6"><label asp-for="CourseId" class="form-label">Course</label><select asp-for="CourseId" asp-items="Model.Courses" class="form-select"><option value="0">Select course</option></select></div><div class="col-md-6"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control"/></div><div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" rows="5" class="form-control"></textarea></div><div class="col-md-4"><label asp-for="DueAt" class="form-label">Due Date/Time</label><input asp-for="DueAt" type="datetime-local" class="form-control"/></div><div class="col-md-4"><label asp-for="TotalMarks" class="form-label"></label><input asp-for="TotalMarks" class="form-control"/></div><div class="col-md-4"><label asp-for="Attachment" class="form-label">Attachment</label><input asp-for="Attachment" class="form-control"/></div><div class="col-12 form-check ms-2"><input asp-for="AllowResubmission" class="form-check-input"/><label asp-for="AllowResubmission" class="form-check-label">Allow resubmission</label></div></div><button class="btn btn-primary mt-4">Save</button> <a asp-action="Index" class="btn btn-outline-secondary mt-4">Cancel</a></div></form>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
