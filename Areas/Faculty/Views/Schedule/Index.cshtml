@model IReadOnlyList<TechnifyERP.Application.Schedules.ClassScheduleDto>
@{ViewData["Title"]="My Schedule";}<h1 class="h2">My Weekly Schedule</h1><p class="text-secondary">Assigned classes, timings aur rooms.</p><div class="row g-3">@foreach(var x in Model){<div class="col-md-6"><div class="card border-0 shadow-sm"><div class="card-body"><span class="badge text-bg-primary">@x.DayOfWeek</span><h2 class="h5 mt-2">@x.CourseCode — @x.CourseName</h2><p class="mb-1">@x.StartTime.ToString("hh:mm tt") — @x.EndTime.ToString("hh:mm tt")</p><strong>Room: @x.Room</strong></div></div></div>}@if(Model.Count==0){<div class="alert alert-info">Schedule available nahi.</div>}</div>
