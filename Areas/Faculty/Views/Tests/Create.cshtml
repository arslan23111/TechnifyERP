@{ViewData["Title"]="Create Test";}<h1 class="h2">Create Test</h1>@if(TempData["ErrorMessage"] is string e){<div class="alert alert-danger">@e</div>}<form method="post" class="card border-0 shadow-sm"><div class="card-body row g-3"><div class="col-md-6"><label>Course</label><select name="courseId" asp-items="ViewBag.Courses" class="form-select"></select></div><div class="col-md-6"><label>Title</label><input name="title" class="form-control" required/></div><div class="col-md-4"><label>Duration Minutes</label><input name="durationMinutes" type="number" min="1" value="30" class="form-control"/></div><div class="col-md-4"><label>Start</label><input name="startsAt" type="datetime-local" class="form-control" required/></div><div class="col-md-4"><label>End</label><input name="endsAt" type="datetime-local" class="form-control" required/></div><div><button class="btn btn-primary">Create & Add Questions</button></div></div></form>
