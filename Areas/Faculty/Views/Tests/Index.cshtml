@model IReadOnlyList<TechnifyERP.Application.Tests.TestDto>
@{ViewData["Title"]="Tests";}<div class="d-flex justify-content-between"><div><h1 class="h2">Tests</h1><p class="text-secondary">Timed MCQ tests manage karein.</p></div><a asp-action="Create" class="btn btn-primary align-self-start">Create Test</a></div><div class="row g-3">@foreach(var x in Model){<div class="col-lg-6"><div class="card border-0 shadow-sm"><div class="card-body"><span class="badge text-bg-primary">@x.CourseCode</span><h2 class="h5 mt-2">@x.Title</h2><p>@x.DurationMinutes min · @x.TotalMarks marks · @x.QuestionCount questions</p><p>@x.StartsAtUtc.ToLocalTime() — @x.EndsAtUtc.ToLocalTime()</p><a asp-action="Questions" asp-route-id="@x.Id" class="btn btn-sm btn-primary">Manage Questions</a></div></div></div>}@if(Model.Count==0){<div class="alert alert-info">No tests.</div>}</div>
