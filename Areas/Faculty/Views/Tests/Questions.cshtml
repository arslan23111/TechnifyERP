@model IReadOnlyList<TechnifyERP.Application.Tests.QuestionDto>
@{var test=(TechnifyERP.Application.Tests.TestDto)ViewBag.Test;ViewData["Title"]="Questions";}<h1 class="h2">@test.Title</h1><p>Total marks: @test.TotalMarks</p><form asp-action="AddQuestion" method="post" class="card border-0 shadow-sm mb-4"><div class="card-body row g-2"><input type="hidden" name="testId" value="@test.Id"/><div class="col-12"><textarea name="text" class="form-control" placeholder="Question" required></textarea></div>@foreach(var option in new[]{"A","B","C","D"}){<div class="col-md-6"><input name="option@option" class="form-control" placeholder="Option @option" required/></div>}<div class="col-md-6"><select name="correctOption" class="form-select"><option>A</option><option>B</option><option>C</option><option>D</option></select></div><div class="col-md-4"><input name="marks" type="number" step="0.01" min="0.01" class="form-control" placeholder="Marks" required/></div><div><button class="btn btn-primary">Add Question</button></div></div></form>@for(var i=0;i<Model.Count;i++){var q=Model[i];<div class="card mb-2"><div class="card-body"><strong>@(i+1). @q.Text</strong><div>A. @q.OptionA · B. @q.OptionB · C. @q.OptionC · D. @q.OptionD</div><div>Correct: @q.CorrectOption · @q.Marks marks</div><form asp-action="DeleteQuestion" method="post"><input type="hidden" name="testId" value="@test.Id"/><input type="hidden" name="questionId" value="@q.Id"/><button class="btn btn-sm btn-danger">Delete</button></form></div></div>}
