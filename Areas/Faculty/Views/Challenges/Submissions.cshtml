@model IReadOnlyList<TechnifyERP.Application.Challenges.CodingSubmissionDto>
@{var challenge=(TechnifyERP.Application.Challenges.ChallengeDto)ViewBag.Challenge;ViewData["Title"]="Challenge Submissions";}<h1 class="h2">@challenge.Title</h1><p class="text-secondary">Student code submissions.</p>@foreach(var x in Model){<div class="card mb-3"><div class="card-body"><div class="d-flex justify-content-between"><strong>@x.StudentName (@x.RegistrationNumber)</strong><span class="badge text-bg-primary">@x.Language</span></div><div class="small text-secondary mb-2">@x.SubmittedAtUtc.ToLocalTime()</div><pre class="bg-dark text-light rounded p-3 overflow-auto"><code>@x.SourceCode</code></pre></div></div>}@if(Model.Count==0){<div class="alert alert-info">No submissions.</div>}
