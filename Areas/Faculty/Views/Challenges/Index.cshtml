@model IReadOnlyList<TechnifyERP.Application.Challenges.ChallengeDto>
@using TechnifyERP.Domain.Enums
@{ViewData["Title"]="Coding Challenges";}<h1 class="h2">Coding Challenges</h1><p class="text-secondary">Course programming problems create karein.</p>@if(TempData["SuccessMessage"] is string s){<div class="alert alert-success">@s</div>}@if(TempData["ErrorMessage"] is string e){<div class="alert alert-danger">@e</div>}
<form asp-action="Create" method="post" class="card border-0 shadow-sm mb-4"><div class="card-body row g-3"><div class="col-md-6"><select name="courseId" asp-items="ViewBag.Courses" class="form-select"></select></div><div class="col-md-4"><input name="title" class="form-control" placeholder="Challenge title" required/></div><div class="col-md-2"><select name="difficulty" class="form-select" asp-items="Html.GetEnumSelectList<ChallengeDifficulty>()"></select></div><div class="col-12"><textarea name="description" rows="4" class="form-control" placeholder="Problem description" required></textarea></div><div class="col-md-6"><textarea name="inputFormat" class="form-control" placeholder="Input format"></textarea></div><div class="col-md-6"><textarea name="outputFormat" class="form-control" placeholder="Output format"></textarea></div><div class="col-md-4"><textarea name="sampleInput" class="form-control" placeholder="Sample input"></textarea></div><div class="col-md-4"><textarea name="sampleOutput" class="form-control" placeholder="Sample output"></textarea></div><div class="col-md-4"><input name="dueAt" type="datetime-local" class="form-control"/></div><div><button class="btn btn-primary">Create Challenge</button></div></div></form>
<div class="row g-3">@foreach(var x in Model){<div class="col-lg-6"><div class="card border-0 shadow-sm"><div class="card-body"><span class="badge text-bg-primary">@x.CourseCode</span> <span class="badge text-bg-secondary">@x.Difficulty</span><h2 class="h5 mt-2">@x.Title</h2><p>@x.Description</p><div>Submissions: @x.SubmissionCount</div><div class="d-flex gap-2 mt-3"><a asp-action="Submissions" asp-route-id="@x.Id" class="btn btn-sm btn-primary">View Submissions</a><form asp-action="Delete" method="post"><input type="hidden" name="id" value="@x.Id"/><button class="btn btn-sm btn-danger">Delete</button></form></div></div></div></div>}@if(Model.Count==0){<div class="alert alert-info">No challenges.</div>}</div>
