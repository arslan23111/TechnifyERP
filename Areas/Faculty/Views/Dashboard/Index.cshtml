@model TechnifyERP.Application.Faculty.FacultyDashboardDto
@{ ViewData["Title"] = "Faculty Dashboard"; }

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div><p class="text-primary fw-semibold mb-1">TECHNIFY ERP</p><h1 class="h2 mb-1">Faculty Dashboard</h1><p class="text-secondary mb-0">Manage your courses, students, and academic work.</p></div>
    <a asp-area="Faculty" asp-controller="Courses" asp-action="Index" class="btn btn-primary">Manage Courses</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-4"><div class="card h-100 border-0 shadow-sm"><div class="card-body"><div class="text-secondary small">Assigned Courses</div><div class="display-6">@Model.AssignedCourses</div></div></div></div>
    <div class="col-6 col-lg-4"><div class="card h-100 border-0 shadow-sm"><div class="card-body"><div class="text-secondary small">Enrolled Students</div><div class="display-6">@Model.EnrolledStudents</div></div></div></div>
    <div class="col-6 col-lg-4"><div class="card h-100 border-0 shadow-sm"><div class="card-body"><div class="text-secondary small">Active Assignments</div><div class="display-6 text-primary">@Model.ActiveAssignments</div></div></div></div>
    <div class="col-6 col-lg-4"><div class="card h-100 border-0 shadow-sm"><div class="card-body"><div class="text-secondary small">Pending Grading</div><div class="display-6 text-warning-emphasis">@Model.PendingGrading</div></div></div></div>
    <div class="col-6 col-lg-4"><div class="card h-100 border-0 shadow-sm"><div class="card-body"><div class="text-secondary small">Upcoming Tests</div><div class="display-6 text-success">@Model.UpcomingTests</div></div></div></div>
    <div class="col-6 col-lg-4"><div class="card h-100 border-0 shadow-sm"><div class="card-body"><div class="text-secondary small">Open Doubts</div><div class="display-6 text-danger">@Model.OpenDoubts</div></div></div></div>
</div>

<section class="card border-0 shadow-sm"><div class="card-body p-4"><h2 class="h4 mb-3">Quick Actions</h2><div class="d-flex flex-wrap gap-2">
    <a class="btn btn-outline-primary" asp-area="Faculty" asp-controller="Attendance" asp-action="Index">Mark Attendance</a>
    <a class="btn btn-outline-primary" asp-area="Faculty" asp-controller="Assignments" asp-action="Index">Assignments</a>
    <a class="btn btn-outline-primary" asp-area="Faculty" asp-controller="Tests" asp-action="Index">Tests</a>
    <a class="btn btn-outline-primary" asp-area="Faculty" asp-controller="Content" asp-action="Index">Learning Content</a>
    <a class="btn btn-outline-primary" asp-area="Faculty" asp-controller="Doubts" asp-action="Index">Answer Doubts</a>
    <a class="btn btn-outline-primary" asp-area="Faculty" asp-controller="Notices" asp-action="Index">Post Notice</a>
    <a class="btn btn-outline-primary" asp-area="Faculty" asp-controller="Messages" asp-action="Index">Messages</a>
</div></div></section>
