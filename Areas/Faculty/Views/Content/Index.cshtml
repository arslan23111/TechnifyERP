@using TechnifyERP.Application.Content
@{ViewData["Title"]="Course Content";var materials=(IReadOnlyList<StudyMaterialDto>)ViewBag.Materials;var lectures=(IReadOnlyList<RecordedLectureDto>)ViewBag.Lectures;}
<h1 class="h2">Course Content</h1><p class="text-secondary">Study materials aur recorded lectures manage karein.</p>
@if(TempData["SuccessMessage"] is string s){<div class="alert alert-success">@s</div>}@if(TempData["ErrorMessage"] is string e){<div class="alert alert-danger">@e</div>}
<div class="row g-4 mb-5"><div class="col-lg-6"><form asp-action="AddMaterial" method="post" enctype="multipart/form-data" class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">Upload Study Material</h2><select name="courseId" asp-items="ViewBag.Courses" class="form-select mb-2"></select><input name="title" class="form-control mb-2" placeholder="Title" required/><textarea name="description" class="form-control mb-2" placeholder="Description"></textarea><input name="file" type="file" accept=".pdf,.ppt,.pptx,.doc,.docx,.zip,.xls,.xlsx" class="form-control mb-2" required/><button class="btn btn-primary">Upload</button></div></form></div><div class="col-lg-6"><form asp-action="AddLecture" method="post" class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">Add Recorded Lecture</h2><select name="courseId" asp-items="ViewBag.Courses" class="form-select mb-2"></select><input name="lectureNumber" type="number" min="1" class="form-control mb-2" placeholder="Lecture number" required/><input name="title" class="form-control mb-2" placeholder="Title" required/><textarea name="description" class="form-control mb-2" placeholder="Description"></textarea><input name="videoUrl" type="url" class="form-control mb-2" placeholder="https://youtube.com/..." required/><button class="btn btn-primary">Add Lecture</button></div></form></div></div>
<h2 class="h4">Uploaded Materials</h2><div class="row g-3 mb-5">@foreach(var x in materials){<div class="col-md-6"><div class="card"><div class="card-body"><span class="badge text-bg-primary">@x.CourseCode</span><h3 class="h6 mt-2">@x.Title</h3><p>@x.Description</p><a href="@x.FilePath" target="_blank">@x.OriginalFileName</a><form asp-action="DeleteMaterial" method="post" class="mt-2"><input type="hidden" name="id" value="@x.Id"/><button class="btn btn-sm btn-outline-danger">Delete</button></form></div></div></div>}@if(materials.Count==0){<p>No materials.</p>}</div>
<h2 class="h4">Recorded Lectures</h2><div class="row g-3">@foreach(var x in lectures){<div class="col-md-6"><div class="card"><div class="card-body"><span class="badge text-bg-primary">@x.CourseCode · Lecture @x.LectureNumber</span><h3 class="h6 mt-2">@x.Title</h3><p>@x.Description</p><a href="@x.VideoUrl" target="_blank" class="btn btn-sm btn-outline-primary">Open Video</a><form asp-action="DeleteLecture" method="post" class="d-inline"><input type="hidden" name="id" value="@x.Id"/><button class="btn btn-sm btn-outline-danger">Delete</button></form></div></div></div>}@if(lectures.Count==0){<p>No lectures.</p>}</div>
