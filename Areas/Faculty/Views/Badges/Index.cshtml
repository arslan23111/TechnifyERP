@{ViewData["Title"]="Award Badges";}<h1 class="h2">Award Badges</h1><p class="text-secondary">Apne course ke eligible student ko achievement badge dein.</p>@if(TempData["SuccessMessage"] is string s){<div class="alert alert-success">@s</div>}@if(TempData["ErrorMessage"] is string e){<div class="alert alert-danger">@e</div>}<form asp-action="Award" method="post" class="card border-0 shadow-sm"><div class="card-body row g-3"><div class="col-md-5"><label>Student</label><select name="studentId" asp-items="ViewBag.Students" class="form-select"><option value="">Select student</option></select></div><div class="col-md-5"><label>Badge</label><select name="badgeId" asp-items="ViewBag.Badges" class="form-select"><option value="">Select badge</option></select></div><div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary w-100">Award</button></div></div></form>
