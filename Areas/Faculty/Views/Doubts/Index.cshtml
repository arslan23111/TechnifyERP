@model IReadOnlyList<TechnifyERP.Application.Doubts.DoubtDto>
@{ViewData["Title"]="Student Doubts";}<h1 class="h2">Student Doubts</h1><p class="text-secondary">Answer student questions from your assigned courses.</p>@foreach(var x in Model){<div class="card mb-3"><div class="card-body"><span class="badge text-bg-primary">@x.CourseCode</span><strong class="ms-2">@x.StudentName (@x.RegistrationNumber)</strong><p class="mt-3">@x.Question</p><form asp-action="Answer" method="post" class="d-flex gap-2"><input type="hidden" name="id" value="@x.Id"/><textarea name="answer" class="form-control" placeholder="Answer" required>@x.Answer</textarea><button class="btn btn-primary">@(x.Answer is null?"Answer":"Update")</button></form></div></div>}@if(Model.Count==0){<div class="alert alert-info">No doubts.</div>}
