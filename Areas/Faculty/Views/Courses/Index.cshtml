@model IReadOnlyList<FacultyCourseDto>
@{
    ViewData["Title"] = "Faculty Courses";
}

<div class="mb-4"><h1 class="h2 mb-1">Course Assignment</h1><p class="text-secondary mb-0">Requirement ke mutabiq available course self-assign karein.</p></div>
@if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger">@error</div> }
<div class="row g-3">
@foreach (var course in Model)
{
    <div class="col-md-6 col-xl-4"><div class="card border-0 shadow-sm h-100"><div class="card-body p-4">
        <div class="d-flex justify-content-between"><span class="badge text-bg-light border">@course.CourseCode</span>@if (course.IsAssigned) { <span class="badge text-bg-success">Assigned</span> }</div>
        <h2 class="h5 mt-3">@course.CourseName</h2><p class="text-secondary">@course.CreditHours credit hours · @course.EnrolledStudents enrolled students</p>
        @if (course.IsAssigned)
        {
            <a asp-action="Students" asp-route-id="@course.CourseId" class="btn btn-outline-primary">View Students</a>
        }
        else
        {
            <form asp-action="Assign" asp-route-id="@course.CourseId" method="post"><button class="btn btn-primary">Assign Course</button></form>
        }
    </div></div></div>
}
</div>
