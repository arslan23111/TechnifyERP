@using TechnifyERP.Application.Notices
@{ViewData["Title"]="Course Notices";var notices=(IReadOnlyList<NoticeDto>)ViewBag.Notices;}
<h1 class="h2">Course Notices</h1><p class="text-secondary">Assigned course ke students ko notice bhejein.</p>@if(TempData["SuccessMessage"] is string s){<div class="alert alert-success">@s</div>}@if(TempData["ErrorMessage"] is string e){<div class="alert alert-danger">@e</div>}
<form asp-action="Create" method="post" enctype="multipart/form-data" class="card border-0 shadow-sm mb-4"><div class="card-body row g-3"><div class="col-md-6"><select name="courseId" asp-items="ViewBag.Courses" class="form-select"></select></div><div class="col-md-6"><input name="title" class="form-control" placeholder="Title" required/></div><div class="col-12"><textarea name="message" class="form-control" rows="4" placeholder="Message" required></textarea></div><div class="col-md-6"><input name="image" type="file" class="form-control"/></div><div><button class="btn btn-primary">Publish</button></div></div></form>
@foreach(var x in notices){<div class="card mb-3"><div class="card-body"><span class="badge text-bg-primary">@x.CourseCode</span><h2 class="h5">@x.Title</h2><p>@x.Message</p><form asp-action="Delete" method="post"><input type="hidden" name="id" value="@x.Id"/><button class="btn btn-sm btn-danger">Delete</button></form></div></div>}
