@model TechnifyERP.ViewModels.Student.StudentDashboardPageViewModel
@{
    ViewData["Title"] = "Student Dashboard";
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
        <span class="text-primary fw-semibold">TECHNIFY ERP</span>
        <h1 class="h2 mb-1">Student Dashboard</h1>
        <p class="text-secondary mb-0">Welcome, @Model.Dashboard.StudentName · @(Model.Dashboard.RegistrationNumber ?? "Registration pending")</p>
    </div>
    <a class="btn btn-outline-primary" asp-area="Student" asp-controller="Enrollments" asp-action="Index">My Courses</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-4"><div class="card h-100 border-0 shadow-sm"><div class="card-body"><div class="text-secondary small">Approved Courses</div><div class="display-6">@Model.Dashboard.ApprovedCourses</div></div></div></div>
    <div class="col-6 col-lg-4"><div class="card h-100 border-0 shadow-sm"><div class="card-body"><div class="text-secondary small">Attendance Logs</div><div class="display-6">@Model.Dashboard.AttendanceLogs</div></div></div></div>
    <div class="col-6 col-lg-4"><div class="card h-100 border-0 shadow-sm"><div class="card-body"><div class="text-secondary small">Pending Assignments</div><div class="display-6 text-warning-emphasis">@Model.Dashboard.PendingAssignments</div></div></div></div>
    <div class="col-6 col-lg-4"><div class="card h-100 border-0 shadow-sm"><div class="card-body"><div class="text-secondary small">Upcoming Tests</div><div class="display-6 text-primary">@Model.Dashboard.UpcomingTests</div></div></div></div>
    <div class="col-6 col-lg-4"><div class="card h-100 border-0 shadow-sm"><div class="card-body"><div class="text-secondary small">Recent Notices</div><div class="display-6">@Model.Dashboard.UnreadNotices</div></div></div></div>
    <div class="col-6 col-lg-4"><div class="card h-100 border-0 shadow-sm"><div class="card-body"><div class="text-secondary small">Earned Badges</div><div class="display-6 text-success">@Model.Dashboard.EarnedBadges</div></div></div></div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-6"><section class="card h-100 border-0 shadow-sm"><div class="card-body p-4"><h2 class="h4">Upcoming Tasks</h2>
        @if (Model.Dashboard.UpcomingTasks.Count == 0) { <p class="text-secondary mb-0">Koi pending assignment ya test nahi hai.</p> }
        else { <div class="list-group list-group-flush">@foreach (var task in Model.Dashboard.UpcomingTasks) { <div class="list-group-item px-0"><div class="d-flex justify-content-between gap-2"><div><span class="badge text-bg-primary me-2">@task.Type</span><strong>@task.Title</strong><div class="small text-secondary mt-1">@task.CourseCode</div></div><small class="text-secondary text-nowrap">@task.DueAtUtc.ToLocalTime().ToString("dd MMM, hh:mm tt")</small></div></div> }</div> }
    </div></section></div>
    <div class="col-lg-6"><section class="card h-100 border-0 shadow-sm"><div class="card-body p-4"><h2 class="h4">Recent Activity</h2>
        @if (Model.Dashboard.RecentActivities.Count == 0) { <p class="text-secondary mb-0">Activity save hote hi yahan nazar aayegi.</p> }
        else { <div class="list-group list-group-flush">@foreach (var activity in Model.Dashboard.RecentActivities) { <div class="list-group-item px-0"><div class="d-flex justify-content-between gap-2"><div><span class="badge text-bg-secondary me-2">@activity.Type</span>@activity.Description</div><small class="text-secondary text-nowrap">@activity.OccurredAtUtc.ToLocalTime().ToString("dd MMM")</small></div></div> }</div> }
    </div></section></div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-7"><section class="card h-100 border-0 shadow-sm"><div class="card-body p-4"><h2 class="h4">Course Progress</h2>
        @if (Model.Dashboard.CourseProgress.Count == 0) { <p class="text-secondary mb-0">Approved course aate hi progress yahan show hogi.</p> }
        else { @foreach (var course in Model.Dashboard.CourseProgress) { <div class="mb-3"><div class="d-flex justify-content-between small mb-1"><span><strong>@course.CourseCode</strong> · @course.CourseName</span><span>@course.Percentage%</span></div><div class="progress" role="progressbar" aria-label="@course.CourseCode progress" aria-valuenow="@course.Percentage" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar" style="width: @course.Percentage%"></div></div><div class="small text-secondary mt-1">@course.CompletedItems of @course.TotalItems assignments/tests completed</div></div> } }
    </div></section></div>
    <div class="col-lg-5"><section class="card h-100 border-0 shadow-sm"><div class="card-body p-4"><h2 class="h4">Leaderboard</h2>
        @if (Model.Dashboard.Leaderboard.Count == 0) { <p class="text-secondary mb-0">Test results aane ke baad top performers yahan show honge.</p> }
        else { <ol class="list-group list-group-numbered">@foreach (var entry in Model.Dashboard.Leaderboard) { <li class="list-group-item d-flex justify-content-between align-items-center @(entry.IsCurrentStudent ? "list-group-item-primary" : "")"><span>@entry.StudentName @(entry.IsCurrentStudent ? "(You)" : "")</span><strong>@entry.Percentage%</strong></li> }</ol> }
    </div></section></div>
</div>

<section class="card border-0 shadow-sm"><div class="card-body p-4">
    <div class="d-flex justify-content-between align-items-center mb-3"><h2 class="h4 mb-0">Attendance Summary</h2><a asp-area="Student" asp-controller="Attendance" asp-action="Index">Full Report</a></div>
    @if (Model.Attendance.Courses.Count == 0) { <p class="text-secondary mb-0">Aap abhi kisi approved course mein enrolled nahi hain.</p> }
    else { <div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Course</th><th>Present</th><th>Absent</th><th>Leave</th><th>Percentage</th><th>Status</th></tr></thead><tbody>@foreach (var course in Model.Attendance.Courses) { var classes = course.Summary.Present + course.Summary.Absent; var low = classes > 0 && course.Summary.Percentage < 75; <tr><td><strong>@course.CourseCode</strong><div class="small text-secondary">@course.CourseName</div></td><td class="text-success">@course.Summary.Present</td><td class="text-danger">@course.Summary.Absent</td><td>@course.Summary.Leave</td><td>@(classes > 0 ? $"{course.Summary.Percentage:0.##}%" : "—")</td><td>@if (classes == 0) { <span class="badge text-bg-secondary">Not marked</span> } else if (low) { <span class="badge text-bg-danger">Below 75%</span> } else { <span class="badge text-bg-success">Good standing</span> }</td></tr> }</tbody></table></div> }
</div></section>
