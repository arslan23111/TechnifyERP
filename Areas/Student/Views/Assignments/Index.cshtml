@model IReadOnlyList<TechnifyERP.Application.Assignments.StudentAssignmentDto>
@{ViewData["Title"]="Assignments";}
<h1 class="h2">My Assignments</h1><p class="text-secondary">Submit your work and check your grades.</p>
@if(TempData["SuccessMessage"] is string success){<div class="alert alert-success">@success</div>}@if(TempData["ErrorMessage"] is string error){<div class="alert alert-danger">@error</div>}
@foreach(var item in Model){var closed=DateTime.UtcNow>item.DueAtUtc;<div class="card border-0 shadow-sm mb-3"><div class="card-body"><div class="d-flex justify-content-between"><div><span class="badge text-bg-primary">@item.CourseCode</span><h2 class="h5 mt-2">@item.Title</h2></div><span class="badge @(closed?"text-bg-danger":"text-bg-success")">@(closed?"Closed":"Open")</span></div><p>@item.Description</p><p>Due: <strong>@item.DueAtUtc.ToLocalTime().ToString("dd MMM yyyy hh:mm tt")</strong> · Marks: @item.TotalMarks</p>@if(item.AttachmentPath is not null){<a href="@item.AttachmentPath" target="_blank" class="btn btn-sm btn-outline-primary mb-3">Download File</a>}@if(item.SubmissionId.HasValue){<div class="alert alert-info">Submitted attempt @item.SubmissionNumber · <a href="@item.SubmissionPath" target="_blank">View</a>@if(item.Marks.HasValue){<div><strong>Grade: @item.Marks / @item.TotalMarks</strong><br/>Feedback: @item.Feedback</div>}</div>}@if(!closed&&(!item.SubmissionId.HasValue||item.AllowResubmission)){<form asp-action="Submit" method="post" enctype="multipart/form-data" class="d-flex gap-2"><input type="hidden" name="assignmentId" value="@item.Id"/><input name="file" type="file" class="form-control" required/><button class="btn btn-primary">@(item.SubmissionId.HasValue?"Resubmit":"Submit")</button></form>}</div></div>}@if(Model.Count==0){<div class="alert alert-info">No assignments are currently available.</div>}
