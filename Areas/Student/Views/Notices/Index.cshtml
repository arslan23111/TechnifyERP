@model IReadOnlyList<TechnifyERP.Application.Notices.NoticeDto>
@{ViewData["Title"]="Notices";}<h1 class="h2">My Notices</h1><p class="text-secondary">Latest institute and course announcements.</p><div class="row g-3">@foreach(var x in Model){<div class="col-lg-6"><article class="card border-0 shadow-sm h-100">@if(x.ImagePath is not null){<img src="@x.ImagePath" class="card-img-top"/>}<div class="card-body"><span class="badge text-bg-primary">@(x.CourseCode??"Institute")</span><h2 class="h5 mt-2">@x.Title</h2><p>@x.Message</p><div class="small text-secondary">By @x.CreatedBy · @x.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy")</div></div></article></div>}@if(Model.Count==0){<div class="alert alert-info">There are no notices for you.</div>}</div>
