@model IReadOnlyList<TechnifyERP.Application.Doubts.DoubtDto>
@{ViewData["Title"]="Ask Instructor";}<h1 class="h2">Ask Instructor</h1><p class="text-secondary">Course-related question submit karein aur answer check karein.</p>@if(TempData["SuccessMessage"] is string s){<div class="alert alert-success">@s</div>}@if(TempData["ErrorMessage"] is string e){<div class="alert alert-danger">@e</div>}
<form asp-action="Ask" method="post" class="card border-0 shadow-sm mb-4"><div class="card-body row g-3"><div class="col-md-4"><select name="courseId" asp-items="ViewBag.Courses" class="form-select"></select></div><div class="col-md-8"><textarea name="question" maxlength="4000" class="form-control" placeholder="Apna question likhein" required></textarea></div><div><button class="btn btn-primary">Submit Question</button></div></div></form>
@foreach(var x in Model){<div class="card border-0 shadow-sm mb-3"><div class="card-body"><span class="badge text-bg-primary">@x.CourseCode</span><span class="float-end badge @(x.Answer is null?"text-bg-warning":"text-bg-success")">@(x.Answer is null?"Pending":"Answered")</span><h2 class="h6 mt-3">Q: @x.Question</h2><div class="small text-secondary">@x.AskedAtUtc.ToLocalTime()</div>@if(x.Answer is not null){<div class="alert alert-success mt-3 mb-0"><strong>Answer by @x.AnsweredBy:</strong><br/>@x.Answer</div>}</div></div>}@if(Model.Count==0){<div class="alert alert-info">Abhi koi question nahi.</div>}
