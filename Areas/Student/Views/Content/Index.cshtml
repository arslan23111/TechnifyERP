@using TechnifyERP.Application.Content
@{ViewData["Title"]="Learning Content";var materials=(IReadOnlyList<StudyMaterialDto>)ViewBag.Materials;var lectures=(IReadOnlyList<RecordedLectureDto>)ViewBag.Lectures;}
<h1 class="h2">Learning Content</h1><p class="text-secondary">Download materials and watch lectures for your enrolled courses.</p>
<h2 class="h4 mt-4">Study Materials</h2><div class="row g-3 mb-5">@foreach(var x in materials){<div class="col-md-6"><div class="card border-0 shadow-sm"><div class="card-body"><span class="badge text-bg-primary">@x.CourseCode</span><h3 class="h5 mt-2">@x.Title</h3><p>@x.Description</p><div class="small text-secondary">By @x.FacultyName</div><a href="@x.FilePath" target="_blank" class="btn btn-primary mt-3">Download @x.OriginalFileName</a></div></div></div>}@if(materials.Count==0){<div class="alert alert-info">No study materials available.</div>}</div>
<h2 class="h4">Recorded Lectures</h2><div class="row g-3">@foreach(var x in lectures){<div class="col-md-6"><div class="card border-0 shadow-sm"><div class="card-body"><span class="badge text-bg-primary">@x.CourseCode · Lecture @x.LectureNumber</span><h3 class="h5 mt-2">@x.Title</h3><p>@x.Description</p><div class="small text-secondary">By @x.FacultyName</div><a href="@x.VideoUrl" target="_blank" rel="noopener" class="btn btn-danger mt-3">Watch Lecture</a></div></div></div>}@if(lectures.Count==0){<div class="alert alert-info">No recorded lectures available.</div>}</div>
