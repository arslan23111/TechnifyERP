@model IReadOnlyList<TechnifyERP.Application.CourseChanges.CourseChangeDto>
@{ViewData["Title"]="Course Changes";}
<h1 class="h2">Course Change Requests</h1><p class="text-secondary">Approved course ko doosre available course mein change karne ki request bhejein.</p>
@if(TempData["SuccessMessage"] is string s){<div class="alert alert-success">@s</div>}@if(TempData["ErrorMessage"] is string e){<div class="alert alert-danger">@e</div>}
<form asp-action="Create" method="post" class="card border-0 shadow-sm mb-4"><div class="card-body row g-3"><div class="col-md-4"><label class="form-label">Current Course</label><select name="fromCourseId" asp-items="ViewBag.Courses" class="form-select"><option value="">Select</option></select></div><div class="col-md-4"><label class="form-label">New Course</label><select name="toCourseId" asp-items="ViewBag.Targets" class="form-select"><option value="">Select</option></select></div><div class="col-md-4"><label class="form-label">Reason</label><input name="reason" class="form-control" required /></div><div class="col-12"><button class="btn btn-primary">Send Request</button></div></div></form>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Change</th><th>Fee Difference</th><th>Reason</th><th>Status</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.FromCourseCode → @x.ToCourseCode</td><td>Rs. @((x.ToFee-x.FromFee).ToString("N2"))</td><td>@x.Reason</td><td>@x.Status</td></tr>}@if(!Model.Any()){<tr><td colspan="4" class="text-center py-4">No requests yet.</td></tr>}</tbody></table></div></div>
