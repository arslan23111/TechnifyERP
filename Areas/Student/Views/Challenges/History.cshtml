@model IReadOnlyList<TechnifyERP.Application.Challenges.CodingSubmissionDto>
@{ViewData["Title"]="Submission History";}<h1 class="h2">Submission History</h1>@foreach(var x in Model){<div class="card mb-3"><div class="card-body"><span class="badge text-bg-primary">@x.Language</span><span class="float-end text-secondary">@x.SubmittedAtUtc.ToLocalTime()</span><pre class="bg-dark text-light rounded p-3 mt-3 overflow-auto"><code>@x.SourceCode</code></pre></div></div>}@if(Model.Count==0){<div class="alert alert-info">No submissions yet.</div>}<a asp-action="Index" class="btn btn-outline-primary">Back</a>
