@model IReadOnlyList<TechnifyERP.Application.Challenges.ChallengeDto>
@{ViewData["Title"]="Coding Challenges";}<h1 class="h2">Coding Challenges</h1><p class="text-secondary">Language choose karke apna code submit karein.</p>@if(TempData["SuccessMessage"] is string s){<div class="alert alert-success">@s</div>}@if(TempData["ErrorMessage"] is string e){<div class="alert alert-danger">@e</div>}
@foreach(var x in Model){var closed=x.DueAtUtc.HasValue&&DateTime.UtcNow>x.DueAtUtc;<div class="card border-0 shadow-sm mb-4"><div class="card-body"><span class="badge text-bg-primary">@x.CourseCode</span> <span class="badge text-bg-secondary">@x.Difficulty</span><h2 class="h4 mt-2">@x.Title</h2><p>@x.Description</p>@if(x.InputFormat is not null){<strong>Input:</strong><pre>@x.InputFormat</pre>}@if(x.OutputFormat is not null){<strong>Output:</strong><pre>@x.OutputFormat</pre>}@if(x.SampleInput is not null){<div class="row"><div class="col"><strong>Sample Input</strong><pre class="bg-light p-2">@x.SampleInput</pre></div><div class="col"><strong>Sample Output</strong><pre class="bg-light p-2">@x.SampleOutput</pre></div></div>}<a asp-action="History" asp-route-id="@x.Id" class="btn btn-sm btn-outline-secondary mb-3">My Submission History</a>@if(!closed){<form asp-action="Submit" method="post"><input type="hidden" name="challengeId" value="@x.Id"/><select name="language" class="form-select mb-2"><option>C#</option><option>JavaScript</option><option>Python</option><option>Java</option><option>C++</option><option>PHP</option></select><textarea name="sourceCode" rows="12" maxlength="30000" class="form-control font-monospace mb-2" placeholder="Write/paste code here" required></textarea><button class="btn btn-primary">Submit Code</button></form>}else{<div class="alert alert-danger">Deadline closed.</div>}</div></div>}@if(Model.Count==0){<div class="alert alert-info">No challenges available.</div>}
