@model IReadOnlyList<TechnifyERP.Application.Badges.StudentBadgeDto>
@{ViewData["Title"]="My Badges";}<h1 class="h2">My Badges</h1><p class="text-secondary">Your earned achievements.</p><div class="row g-3">@foreach(var x in Model){<div class="col-md-4"><div class="card border-0 shadow-sm h-100"><div class="card-body text-center"><div class="display-4">🏅</div><h2 class="h5">@x.BadgeName</h2><p>@x.BadgeDescription</p><div class="small text-secondary">Awarded by @x.AwardedBy<br/>@x.AwardedAtUtc.ToLocalTime().ToString("dd MMM yyyy")</div></div></div></div>}@if(Model.Count==0){<div class="alert alert-info">Aap ne abhi koi badge earn nahi kiya.</div>}</div>
