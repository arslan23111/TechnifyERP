@model TechnifyERP.Application.Profiles.StudentProfileDto
@{ViewData["Title"]="My Profile";}<h1 class="h2">My Profile</h1><p class="text-secondary">Personal details aur profile picture update karein.</p>@if(TempData["SuccessMessage"] is string s){<div class="alert alert-success">@s</div>}@if(TempData["ErrorMessage"] is string e){<div class="alert alert-danger">@e</div>}<div class="row g-4"><div class="col-lg-4"><div class="card border-0 shadow-sm"><div class="card-body text-center">@if(Model.ProfilePicturePath is not null){<img src="@Model.ProfilePicturePath" class="img-fluid rounded-circle mb-3" style="width:160px;height:160px;object-fit:cover"/>}else{<div class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center mb-3" style="width:160px;height:160px;font-size:52px">@Model.FullName[0]</div>}<h2 class="h5">@Model.FullName</h2><div>@Model.Email</div><div class="text-secondary">@Model.RegistrationNumber</div></div></div></div><div class="col-lg-8"><form asp-action="Update" method="post" enctype="multipart/form-data" class="card border-0 shadow-sm"><div class="card-body row g-3"><div class="col-md-6"><label class="form-label">Full Name</label><input name="fullName" value="@Model.FullName" class="form-control" required/></div><div class="col-md-6"><label class="form-label">Phone</label><input name="phoneNumber" value="@Model.PhoneNumber" class="form-control"/></div><div class="col-md-6"><label class="form-label">Gender</label><select name="gender" class="form-select"><option value="">Select</option><option selected="@(Model.Gender=="Male")">Male</option><option selected="@(Model.Gender=="Female")">Female</option><option selected="@(Model.Gender=="Other")">Other</option></select></div><div class="col-md-6"><label class="form-label">Date of Birth</label><input name="dateOfBirth" type="date" value="@(Model.DateOfBirth?.ToString("yyyy-MM-dd"))" class="form-control"/></div><div class="col-12"><label class="form-label">Address</label><textarea name="address" class="form-control">@Model.Address</textarea></div><div class="col-12"><label class="form-label">Profile Picture</label><input name="picture" type="file" accept=".jpg,.jpeg,.png,.webp" class="form-control"/></div><div><button class="btn btn-primary">Save Profile</button></div></div></form></div></div>
