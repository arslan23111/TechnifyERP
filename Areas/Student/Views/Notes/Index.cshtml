@model IReadOnlyList<TechnifyERP.Application.Notes.StudentNoteDto>
@{ViewData["Title"]="My Notes";}<h1 class="h2">My Personal Notes</h1><p class="text-secondary">Private notes are visible only to you.</p>@if(TempData["SuccessMessage"] is string s){<div class="alert alert-success">@s</div>}@if(TempData["ErrorMessage"] is string e){<div class="alert alert-danger">@e</div>}<form asp-action="Save" method="post" class="card border-0 shadow-sm mb-4"><div class="card-body row g-2"><input type="hidden" name="id" value="0"/><div class="col-md-4"><select name="courseId" asp-items="ViewBag.Courses" class="form-select"><option value="">General note (no course)</option></select></div><div class="col-md-8"><input name="title" class="form-control" placeholder="Note title" required/></div><div class="col-12"><textarea name="content" rows="4" class="form-control" placeholder="Write note" required></textarea></div><div><button class="btn btn-primary">Save Note</button></div></div></form><div class="row g-3">@foreach(var x in Model){<div class="col-md-6"><div class="card border-0 shadow-sm"><div class="card-body"><span class="badge text-bg-secondary">@(x.CourseCode??"General")</span><h2 class="h5 mt-2">@x.Title</h2><p style="white-space:pre-wrap">@x.Content</p><small class="text-secondary">Updated @x.UpdatedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</small><details class="mt-2"><summary>Edit</summary><form asp-action="Save" method="post" class="mt-2"><input type="hidden" name="id" value="@x.Id"/><select name="courseId" asp-items="ViewBag.Courses" class="form-select mb-2"><option value="">General note</option></select><input name="title" value="@x.Title" class="form-control mb-2"/><textarea name="content" class="form-control mb-2">@x.Content</textarea><button class="btn btn-sm btn-primary">Update</button></form></details><form asp-action="Delete" method="post" class="mt-2"><input type="hidden" name="id" value="@x.Id"/><button class="btn btn-sm btn-outline-danger">Delete</button></form></div></div></div>}@if(Model.Count==0){<div class="alert alert-info">No notes yet.</div>}</div>
