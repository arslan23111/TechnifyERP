@model TechnifyERP.Application.Tests.TestAttemptDto
@{ViewData["Title"]="Take Test";}<div class="d-flex justify-content-between"><h1 class="h2">@Model.Title</h1><div class="alert alert-warning">Time: <strong id="timer"></strong></div></div><form asp-action="Submit" method="post" id="testForm"><input type="hidden" name="testId" value="@Model.Id"/>@for(var i=0;i<Model.Questions.Count;i++){var q=Model.Questions[i];<div class="card mb-3"><div class="card-body"><h2 class="h5">@(i+1). @q.Text (@q.Marks marks)</h2>@foreach(var o in new[]{('A',q.OptionA),('B',q.OptionB),('C',q.OptionC),('D',q.OptionD)}){<div class="form-check"><input class="form-check-input" type="radio" name="answers[@q.Id]" value="@o.Item1" id="q@(q.Id)@o.Item1"/><label class="form-check-label" for="q@(q.Id)@o.Item1">@o.Item1. @o.Item2</label></div>}</div></div>}<button class="btn btn-danger">Submit Test</button></form><script>let s=@(Model.DurationMinutes*60);const e=document.getElementById('timer'),f=document.getElementById('testForm');const t=setInterval(()=>{e.textContent=Math.floor(s/60)+':'+String(s%60).padStart(2,'0');if(s--<=0){clearInterval(t);f.submit();}},1000);</script>
