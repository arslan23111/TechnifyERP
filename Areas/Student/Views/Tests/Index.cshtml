@model IReadOnlyList<TechnifyERP.Application.Tests.StudentTestDto>
@{ViewData["Title"]="Tests";}<h1 class="h2">My Tests</h1><div class="row g-3">@foreach(var x in Model){var active=DateTime.UtcNow>=x.StartsAtUtc&&DateTime.UtcNow<=x.EndsAtUtc;<div class="col-lg-6"><div class="card border-0 shadow-sm"><div class="card-body"><span class="badge text-bg-primary">@x.CourseCode</span><h2 class="h5">@x.Title</h2><p>@x.DurationMinutes minutes · @x.TotalMarks marks</p>@if(x.Attempted){<div class="alert alert-success">Attempted · Score @x.Score / @x.TotalMarks</div>}else if(active){<a asp-action="Take" asp-route-id="@x.Id" class="btn btn-danger">Start Test</a>}else{<span class="badge text-bg-secondary">Not Active</span>}</div></div></div>}@if(Model.Count==0){<div class="alert alert-info">No tests.</div>}</div>
