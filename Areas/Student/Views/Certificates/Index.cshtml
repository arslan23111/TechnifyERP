@model IReadOnlyList<TechnifyERP.Application.Certificates.CertificateDto>
@{ViewData["Title"]="My Certificates";}<h1 class="h2">My Certificates</h1><div class="row g-3">@foreach(var x in Model){<div class="col-md-6"><div class="card border-0 shadow-sm"><div class="card-body"><div class="display-5">📜</div><h2 class="h5">@x.CourseCode — @x.CourseName</h2><p class="text-secondary">Code: @x.CertificateCode</p><a asp-action="Print" asp-route-id="@x.Id" class="btn btn-primary">Open / Save as PDF</a></div></div></div>}@if(Model.Count==0){<div class="alert alert-info">Abhi koi certificate issue nahi hua.</div>}</div>
