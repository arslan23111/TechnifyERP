@model IReadOnlyList<InstallmentRequestDto>
@using TechnifyERP.Domain.Enums
@{ViewData["Title"]="My Installments";}<h1 class="h2">My Installment Requests</h1><p class="text-secondary">Request status yahan check karein.</p>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Course/Month</th><th>Fee</th><th>Requested</th><th>Reason</th><th>Status</th></tr></thead><tbody>@if(Model.Count==0){<tr><td colspan="5" class="text-center py-5">Abhi koi request nahi.</td></tr>}@foreach(var item in Model){<tr><td>@item.CourseCode · @item.Month/@item.Year</td><td>Rs. @item.FeeAmount.ToString("N2")</td><td>Rs. @item.RequestedAmount.ToString("N2")</td><td>@item.Reason</td><td><span class="badge @(item.Status==InstallmentRequestStatus.Approved?"text-bg-success":item.Status==InstallmentRequestStatus.Rejected?"text-bg-danger":"text-bg-warning")">@item.Status</span><div>@item.AdminRemarks</div></td></tr>}</tbody></table></div></div>
