@model FeeReportDto
@using TechnifyERP.Domain.Enums
@{ ViewData["Title"]="My Fees"; }
<div class="mb-4"><h1 class="h2">My Fee Status</h1><p class="text-secondary">Upload a payment receipt or submit an installment request.</p></div>
@if(TempData["SuccessMessage"] is string success){<div class="alert alert-success">@success</div>} @if(TempData["ErrorMessage"] is string error){<div class="alert alert-danger">@error</div>}
@foreach(var fee in Model.Records){<div class="card border-0 shadow-sm mb-3"><div class="card-body"><div class="d-flex justify-content-between"><h2 class="h5">@fee.CourseCode — @fee.CourseName (@fee.Month/@fee.Year)</h2><span class="badge @(fee.Status==FeeStatus.Paid?"text-bg-success":fee.Status==FeeStatus.Submitted?"text-bg-info":fee.Status==FeeStatus.Overdue?"text-bg-danger":"text-bg-warning")">@fee.Status</span></div><p>Fee: <strong>Rs. @fee.AmountDue.ToString("N2")</strong> · Due: @fee.DueDate.ToString("dd MMM yyyy")</p>
@if(!string.IsNullOrWhiteSpace(fee.AdminRemarks)){<div class="alert alert-secondary py-2">Admin: @fee.AdminRemarks</div>}
@if(fee.Status is FeeStatus.Pending or FeeStatus.Overdue){<div class="row g-3"><div class="col-lg-6"><form asp-action="SubmitReceipt" method="post" enctype="multipart/form-data" class="border rounded p-3"><h3 class="h6">Upload Receipt</h3><input type="hidden" name="feeRecordId" value="@fee.Id"/><input name="amount" type="number" step="0.01" max="@fee.AmountDue" value="@fee.AmountDue" class="form-control mb-2" required/><input name="receipt" type="file" accept=".pdf,.jpg,.jpeg,.png" class="form-control mb-2" required/><button class="btn btn-primary btn-sm">Submit</button></form></div><div class="col-lg-6"><form asp-action="RequestInstallment" method="post" class="border rounded p-3"><h3 class="h6">Request Installment</h3><input type="hidden" name="feeRecordId" value="@fee.Id"/><input name="amount" type="number" step="0.01" max="@(fee.AmountDue-0.01m)" placeholder="Amount" class="form-control mb-2" required/><textarea name="reason" placeholder="Reason" class="form-control mb-2" required></textarea><button class="btn btn-outline-primary btn-sm">Send Request</button></form></div></div>}
else if(fee.Status==FeeStatus.Submitted){<div class="alert alert-info mb-0">Your receipt is under administrator review. Submitted: Rs. @fee.SubmittedAmount?.ToString("N2")</div>}
</div></div>} @if(Model.Records.Count==0){<div class="alert alert-info">No fee records.</div>}
