@model IReadOnlyList<TechnifyERP.Application.Enrollments.StudentEnrollmentRequestDto>
@{ ViewData["Title"] = "My Courses"; }
<h1 class="h2">My Courses</h1><p class="text-secondary">Naye course ke liye enrollment request bhejein aur status check karein.</p>
@if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger">@error</div> }
<form asp-action="RequestEnrollment" method="post" class="card border-0 shadow-sm mb-4"><div class="card-body d-flex gap-2"><select name="courseId" asp-items="ViewBag.Courses" class="form-select"><option value="">Select new course</option></select><button class="btn btn-primary">Request Enrollment</button></div></form>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Course</th><th>Credits</th><th>Monthly Fee</th><th>Status</th><th>Requested</th></tr></thead><tbody>@foreach(var x in Model){<tr><td><strong>@x.CourseCode</strong> - @x.CourseName</td><td>@x.CreditHours</td><td>Rs. @x.MonthlyFee.ToString("N2")</td><td><span class="badge @(x.Status==TechnifyERP.Domain.Enums.EnrollmentStatus.Approved?"text-bg-success":x.Status==TechnifyERP.Domain.Enums.EnrollmentStatus.Rejected?"text-bg-danger":"text-bg-warning")">@x.Status</span></td><td>@x.RequestedAtUtc.ToLocalTime().ToString("dd MMM yyyy")</td></tr>}@if(Model.Count==0){<tr><td colspan="5" class="text-center py-5">No enrollment requests.</td></tr>}</tbody></table></div></div>
