@using TechnifyERP.Application.Notices
@using TechnifyERP.Domain.Enums
@{ViewData["Title"]="Notices";var notices=(IReadOnlyList<NoticeDto>)ViewBag.Notices;}
<h1 class="h2">Notices</h1><p class="text-secondary">All students, course ya specific student ko notice bhejein.</p>@if(TempData["SuccessMessage"] is string s){<div class="alert alert-success">@s</div>}@if(TempData["ErrorMessage"] is string e){<div class="alert alert-danger">@e</div>}
<form asp-action="Create" method="post" enctype="multipart/form-data" class="card border-0 shadow-sm mb-4"><div class="card-body row g-3"><div class="col-md-6"><input name="title" class="form-control" placeholder="Notice title" required/></div><div class="col-md-6"><select name="audience" id="audience" class="form-select"><option value="1">All Students</option><option value="2">Specific Course</option><option value="3">Specific Student</option></select></div><div class="col-12"><textarea name="message" rows="4" class="form-control" placeholder="Message" required></textarea></div><div class="col-md-6" id="courseBox" hidden><select name="courseId" asp-items="ViewBag.Courses" class="form-select"><option value="">Select course</option></select></div><div class="col-md-6" id="studentBox" hidden><select name="studentUserId" asp-items="ViewBag.Students" class="form-select"><option value="">Select student</option></select></div><div class="col-md-6"><input name="image" type="file" accept=".jpg,.jpeg,.png,.webp" class="form-control"/></div><div><button class="btn btn-primary">Publish Notice</button></div></div></form>
<div class="row g-3">@foreach(var x in notices){<div class="col-md-6"><div class="card border-0 shadow-sm"><div class="card-body">@if(x.ImagePath is not null){<img src="@x.ImagePath" class="img-fluid rounded mb-3"/>}<span class="badge text-bg-primary">@x.Audience @(x.CourseCode is null?"":$"· {x.CourseCode}")</span><h2 class="h5 mt-2">@x.Title</h2><p>@x.Message</p><form asp-action="Delete" method="post"><input type="hidden" name="id" value="@x.Id"/><button class="btn btn-sm btn-outline-danger">Delete</button></form></div></div></div>}@if(notices.Count==0){<div class="alert alert-info">No notices.</div>}</div>
<script>const a=document.getElementById('audience'),c=document.getElementById('courseBox'),s=document.getElementById('studentBox');function toggle(){c.hidden=a.value!=='2';s.hidden=a.value!=='3'}a.addEventListener('change',toggle);toggle();</script>
