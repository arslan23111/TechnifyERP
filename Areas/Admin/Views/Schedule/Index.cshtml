@model IReadOnlyList<TechnifyERP.Application.Schedules.ClassScheduleDto>
@using TechnifyERP.Application.Schedules
@{ViewData["Title"]="Class Schedule";var options=(IReadOnlyList<FacultyCourseOptionDto>)ViewBag.Options;}
<h1 class="h2">Class Schedule</h1><p class="text-secondary">Weekly course timetable manage karein.</p>@if(TempData["SuccessMessage"] is string s){<div class="alert alert-success">@s</div>}@if(TempData["ErrorMessage"] is string e){<div class="alert alert-danger">@e</div>}
<form asp-action="Create" method="post" class="card border-0 shadow-sm mb-4"><div class="card-body row g-3"><div class="col-lg-4"><label>Course & Faculty</label><select name="assignment" class="form-select">@foreach(var x in options){<option value="@x.CourseId|@x.FacultyUserId">@x.CourseCode — @x.CourseName · @x.FacultyName</option>}</select></div><div class="col-md-2"><label>Day</label><select name="dayOfWeek" class="form-select">@foreach(var d in Enum.GetValues<DayOfWeek>().Where(x=>x!=DayOfWeek.Sunday)){<option value="@d">@d</option>}</select></div><div class="col-md-2"><label>Start</label><input name="startTime" type="time" class="form-control" required/></div><div class="col-md-2"><label>End</label><input name="endTime" type="time" class="form-control" required/></div><div class="col-md-2"><label>Room</label><input name="room" class="form-control" required/></div><div><button class="btn btn-primary">Add Schedule</button></div></div></form>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Day</th><th>Time</th><th>Course</th><th>Faculty</th><th>Room</th><th></th></tr></thead><tbody>@if(Model.Count==0){<tr><td colspan="6" class="text-center py-5">No schedule.</td></tr>}@foreach(var x in Model){<tr><td><strong>@x.DayOfWeek</strong></td><td>@x.StartTime.ToString("hh:mm tt") — @x.EndTime.ToString("hh:mm tt")</td><td>@x.CourseCode — @x.CourseName</td><td>@x.FacultyName</td><td>@x.Room</td><td><form asp-action="Delete" method="post"><input type="hidden" name="id" value="@x.Id"/><button class="btn btn-sm btn-danger">Delete</button></form></td></tr>}</tbody></table></div></div>
