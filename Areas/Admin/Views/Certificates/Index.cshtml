@model IReadOnlyList<TechnifyERP.Application.Certificates.CertificateDto>
@{ViewData["Title"]="Certificates";}<h1 class="h2">Certificates</h1><p class="text-secondary">Approved enrollment ke liye certificate issue karein.</p>@if(TempData["SuccessMessage"] is string s){<div class="alert alert-success">@s</div>}@if(TempData["ErrorMessage"] is string e){<div class="alert alert-danger">@e</div>}<form asp-action="Issue" method="post" class="card border-0 shadow-sm mb-4"><div class="card-body d-flex gap-2"><select name="enrollment" asp-items="ViewBag.Eligible" class="form-select"><option value="">Student aur course select karein</option></select><button class="btn btn-primary">Issue Certificate</button></div></form><div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Code</th><th>Student</th><th>Course</th><th>Issue Date</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.CertificateCode</td><td>@x.StudentName</td><td>@x.CourseCode — @x.CourseName</td><td>@x.IssueDate.ToString("dd MMM yyyy")</td><td><a asp-action="Print" asp-route-id="@x.Id" class="btn btn-sm btn-outline-primary">Open / Print</a></td></tr>}@if(Model.Count==0){<tr><td colspan="5" class="text-center py-5">No certificates issued.</td></tr>}</tbody></table></div></div>
