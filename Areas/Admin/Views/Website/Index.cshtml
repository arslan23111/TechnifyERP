@model TechnifyERP.Application.Website.HomepageContentDto
@{ ViewData["Title"] = "Homepage Editor"; }
<div class="mb-4"><span class="text-primary fw-semibold">WEBSITE MANAGEMENT</span><h1 class="h2 mb-1">Homepage Editor</h1><p class="text-secondary mb-0">Public homepage ka hero aur footer content yahan se update karein.</p></div>
@if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success">@success</div> }
<form asp-action="Save" method="post" class="card border-0 shadow-sm"><div class="card-body p-4"><div class="row g-3"><div class="col-12"><label asp-for="HeroTitle" class="form-label">Hero Title</label><input asp-for="HeroTitle" class="form-control" required maxlength="200" /></div><div class="col-12"><label asp-for="HeroSubtitle" class="form-label">Hero Subtitle</label><textarea asp-for="HeroSubtitle" class="form-control" rows="3" required maxlength="1000"></textarea></div><div class="col-md-6"><label asp-for="PrimaryButtonText" class="form-label">Button Text</label><input asp-for="PrimaryButtonText" class="form-control" required maxlength="100" /></div><div class="col-md-6"><label asp-for="PrimaryButtonUrl" class="form-label">Button Link</label><input asp-for="PrimaryButtonUrl" class="form-control" placeholder="/Identity/Account/Register" maxlength="500" /></div><div class="col-12"><label asp-for="FooterText" class="form-label">Footer Text</label><input asp-for="FooterText" class="form-control" required maxlength="500" /></div><div class="col-12"><button class="btn btn-primary">Save Homepage</button><a class="btn btn-outline-secondary ms-2" asp-area="" asp-controller="Home" asp-action="Index">Preview Home</a></div></div></div></form>
<form asp-action="SaveSections" method="post" class="card border-0 shadow-sm mt-4"><div class="card-body p-4"><h2 class="h4">Statistics & Feature Cards</h2><p class="text-secondary">Blank row save nahi hogi. Har section mein 3 cards fill kar sakte hain.</p><div class="row g-3">@for(var i=0;i<3;i++){var stat=i<Model.Stats.Count?Model.Stats[i]:null;var feature=i<Model.Features.Count?Model.Features[i]:null;<div class="col-md-4"><label class="form-label">Stat @(i+1) Label</label><input class="form-control mb-2" name="stats[@i].Label" value="@stat?.Label" placeholder="Students"/><input class="form-control" name="stats[@i].Value" value="@stat?.Value" placeholder="500+"/><input type="hidden" name="stats[@i].DisplayOrder" value="@i"/></div>}@for(var i=0;i<3;i++){var feature=i<Model.Features.Count?Model.Features[i]:null;<div class="col-md-4"><label class="form-label">Feature @(i+1) Title</label><input class="form-control mb-2" name="features[@i].Title" value="@feature?.Title" placeholder="Learning"/><textarea class="form-control" name="features[@i].Description" rows="3" placeholder="Feature description">@feature?.Description</textarea><input type="hidden" name="features[@i].DisplayOrder" value="@i"/></div>}<div class="col-12"><button class="btn btn-primary">Save Cards</button></div></div></div></form>
