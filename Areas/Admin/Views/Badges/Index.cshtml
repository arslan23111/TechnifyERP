@model IReadOnlyList<TechnifyERP.Application.Badges.BadgeDto>
@{ViewData["Title"]="Badges";}<h1 class="h2">Badge Definitions</h1><p class="text-secondary">Achievement badges create aur manage karein.</p>@if(TempData["SuccessMessage"] is string s){<div class="alert alert-success">@s</div>}@if(TempData["ErrorMessage"] is string e){<div class="alert alert-danger">@e</div>}<form asp-action="Create" method="post" class="card border-0 shadow-sm mb-4"><div class="card-body row g-2"><div class="col-md-4"><input name="name" class="form-control" placeholder="Badge name" required/></div><div class="col-md-6"><input name="description" class="form-control" placeholder="Description" required/></div><div class="col-md-2"><button class="btn btn-primary w-100">Create</button></div></div></form><div class="row g-3">@foreach(var x in Model){<div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body"><div class="fs-2">🏅</div><h2 class="h5">@x.Name</h2><p>@x.Description</p><form asp-action="Delete" method="post"><input type="hidden" name="id" value="@x.Id"/><button class="btn btn-sm btn-outline-danger">Delete</button></form></div></div></div>}@if(Model.Count==0){<div class="alert alert-info">No badges.</div>}</div>
