@model TechnifyERP.Application.Admin.AdminDashboardDto
@{
    ViewData["Title"] = "Super Admin Dashboard";
}

<div class="dashboard-header d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 mt-3">
    <div>
        <p class="text-primary fw-semibold mb-1">TECHNIFY ERP</p>
        <h1 class="h2 mb-1">Super Admin Dashboard</h1>
        <p class="text-secondary mb-0">Manage the institution's academic, financial, and user operations from one place.</p>
    </div>
    <span class="badge rounded-pill text-bg-success px-3 py-2">System Online</span>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card dashboard-kpi h-100 shadow-sm border-0">
            <div class="card-body">
                <p class="text-secondary mb-2">Students</p>
                <h2 class="display-6 fw-semibold mb-0">@Model.ActiveStudents</h2>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card dashboard-kpi h-100 shadow-sm border-0">
            <div class="card-body">
                <p class="text-secondary mb-2">Faculty</p>
                <h2 class="display-6 fw-semibold mb-0">@Model.ActiveFaculty</h2>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card dashboard-kpi h-100 shadow-sm border-0">
            <div class="card-body">
                <p class="text-secondary mb-2">Active Courses</p>
                <h2 class="display-6 fw-semibold mb-0">@Model.Courses</h2>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card dashboard-kpi h-100 shadow-sm border-0">
            <div class="card-body">
                <p class="text-secondary mb-2">Pending Approvals</p>
                <h2 class="display-6 fw-semibold mb-0">@Model.PendingApprovals</h2>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        <h2 class="h5">Live dashboard connected</h2>
        <p class="text-secondary mb-0">
            These counts are live from SQL Server. Fee and reporting modules are connected as data becomes available.
        </p>
    </div>
</div>
