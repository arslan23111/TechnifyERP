@model IReadOnlyList<CourseDto>
@{
    ViewData["Title"] = "Courses";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 mb-1">Courses</h1>
        <p class="text-secondary mb-0">Manage institute courses, credit hours, and monthly fees.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Add Course</a>
</div>

@if (TempData["SuccessMessage"] is string message)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @message
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Code</th>
                    <th>Course Name</th>
                    <th>Credit Hours</th>
                    <th>Monthly Fee</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-secondary py-5">No courses have been added yet.</td></tr>
                }
                else
                {
                    @foreach (var course in Model)
                    {
                        <tr>
                            <td><span class="badge text-bg-light border">@course.CourseCode</span></td>
                            <td class="fw-semibold">@course.Name</td>
                            <td>@course.CreditHours</td>
                            <td>Rs. @course.MonthlyFee.ToString("N2")</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@course.Id" class="btn btn-sm btn-outline-secondary">View</a>
                                <a asp-action="Edit" asp-route-id="@course.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                <a asp-action="Delete" asp-route-id="@course.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
