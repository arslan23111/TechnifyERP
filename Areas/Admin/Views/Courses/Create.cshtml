@model CourseFormViewModel
@{
    ViewData["Title"] = "Add Course";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <h1 class="h3">Add Course</h1>
                <p class="text-secondary">Requirement ke mutabiq course ki basic academic aur fee information enter karein.</p>
                <form asp-action="Create" method="post">
                    <partial name="_CourseForm" model="Model" />
                    <button type="submit" class="btn btn-primary">Save Course</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
