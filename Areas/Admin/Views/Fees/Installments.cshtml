@model IReadOnlyList<TechnifyERP.Application.Fees.InstallmentRequestDto>
@using TechnifyERP.Domain.Enums
@{ViewData["Title"]="Installments";}<h1 class="h2">Installment Requests</h1><p class="text-secondary">Student requests review karein.</p>
@if(TempData["SuccessMessage"] is string success){<div class="alert alert-success">@success</div>} @if(TempData["ErrorMessage"] is string error){<div class="alert alert-danger">@error</div>}
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Student</th><th>Fee</th><th>Request</th><th>Action</th></tr></thead><tbody>@if(Model.Count==0){<tr><td colspan="4" class="text-center py-5">No requests.</td></tr>}@foreach(var item in Model){<tr><td>@item.StudentName<div class="small">@item.RegistrationNumber</div></td><td>@item.CourseCode · @item.Month/@item.Year<br/>Rs. @item.FeeAmount.ToString("N2")</td><td>Rs. @item.RequestedAmount.ToString("N2")<div class="small">@item.Reason</div></td><td>@if(item.Status==InstallmentRequestStatus.Pending){<form asp-action="ReviewInstallment" method="post" class="d-flex gap-2"><input type="hidden" name="id" value="@item.Id"/><input name="remarks" class="form-control form-control-sm" placeholder="Remarks"/><button name="approve" value="true" class="btn btn-success btn-sm">Approve</button><button name="approve" value="false" class="btn btn-danger btn-sm">Reject</button></form>}else{<span class="badge">@item.Status</span> @item.AdminRemarks}</td></tr>}</tbody></table></div></div>
