@model TechnifyERP.Application.Fees.FeeReportDto
@using TechnifyERP.Domain.Enums
@{ ViewData["Title"] = "Fee Collection"; }
<div class="mb-4"><h1 class="h2">Fee Collection Report</h1><p class="text-secondary">Monthly dues aur submitted receipts manage karein.</p></div>
@if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger">@error</div> }
<form method="get" class="card border-0 shadow-sm mb-4"><div class="card-body row g-3 align-items-end"><div class="col-md-4"><label class="form-label">Month</label><select name="month" class="form-select">@for(var m=1;m<=12;m++){<option value="@m" selected="@(m==Model.Month)">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)</option>}</select></div><div class="col-md-4"><label class="form-label">Year</label><input name="year" type="number" value="@Model.Year" class="form-control"/></div><div class="col-md-4"><button class="btn btn-primary w-100">Load</button></div></div></form>
<div class="row g-3 mb-4"><div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body">Total Due<h3>Rs. @Model.TotalDue.ToString("N2")</h3></div></div></div><div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body">Collected<h3 class="text-success">Rs. @Model.TotalPaid.ToString("N2")</h3></div></div></div><div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body">Balance<h3 class="text-danger">Rs. @Model.TotalPending.ToString("N2")</h3></div></div></div></div>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Student/Course</th><th>Fee</th><th>Status</th><th>Action</th></tr></thead><tbody>
@if(Model.Records.Count==0){<tr><td colspan="4" class="text-center py-5">No fee records.</td></tr>}
@foreach(var fee in Model.Records){<tr><td><strong>@fee.StudentName</strong><div class="small">@fee.RegistrationNumber · @fee.CourseCode — @fee.CourseName</div><div class="small">Due @fee.DueDate.ToString("dd MMM yyyy")</div></td><td>Rs. @fee.AmountDue.ToString("N2")<div class="small text-success">Paid Rs. @fee.AmountPaid.ToString("N2")</div></td><td><span class="badge @(fee.Status==FeeStatus.Paid?"text-bg-success":fee.Status==FeeStatus.Submitted?"text-bg-info":fee.Status==FeeStatus.Overdue?"text-bg-danger":"text-bg-warning")">@fee.Status</span></td><td>
@if(fee.Status==FeeStatus.Submitted){<a href="@fee.PaymentReceiptPath" target="_blank" class="btn btn-sm btn-outline-primary mb-2">View Receipt (Rs. @fee.SubmittedAmount?.ToString("N2"))</a><form asp-action="ReviewReceipt" method="post" class="d-flex gap-2"><input type="hidden" name="id" value="@fee.Id"/><input type="hidden" name="month" value="@Model.Month"/><input type="hidden" name="year" value="@Model.Year"/><input name="remarks" class="form-control form-control-sm" placeholder="Remarks"/><button name="approve" value="true" class="btn btn-sm btn-success">Approve</button><button name="approve" value="false" class="btn btn-sm btn-danger">Reject</button></form>}
else if(fee.Status!=FeeStatus.Paid){<form asp-action="MarkPaid" method="post" class="d-flex gap-2"><input type="hidden" name="id" value="@fee.Id"/><input type="hidden" name="month" value="@Model.Month"/><input type="hidden" name="year" value="@Model.Year"/><input name="amount" type="number" step="0.01" max="@fee.AmountDue" value="@fee.AmountDue" class="form-control form-control-sm"/><button class="btn btn-sm btn-success">Direct Paid</button></form>}
</td></tr>}
</tbody></table></div></div>
