@model IReadOnlyList<TechnifyERP.Application.Accounts.PendingAccountDto>
@{
    ViewData["Title"] = "Account Approvals";
}

<div class="mb-4">
    <h1 class="h2 mb-1">Account Approvals</h1>
    <p class="text-secondary mb-0">Review pending student and faculty registration requests.</p>
</div>

@if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger">@error</div> }

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th>Name</th><th>Role</th><th>Contact</th><th>Requested Course</th><th>Submitted</th><th class="text-end">Actions</th></tr></thead>
            <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-secondary py-5">No pending account requests.</td></tr>
            }
            else
            {
                @foreach (var account in Model)
                {
                    <tr>
                        <td><strong>@account.FullName</strong><br /><small class="text-secondary">@account.Email</small></td>
                        <td><span class="badge text-bg-light border">@account.UserType</span></td>
                        <td>@(account.PhoneNumber ?? "—")</td>
                        <td>@(account.RequestedCourse ?? "—")</td>
                        <td>@account.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy")</td>
                        <td class="text-end">
                            <form asp-action="Approve" asp-route-id="@account.UserId" method="post" class="d-inline"><button class="btn btn-sm btn-success">Approve</button></form>
                            <form asp-action="Reject" asp-route-id="@account.UserId" method="post" class="d-inline"><button class="btn btn-sm btn-outline-danger">Reject</button></form>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
