@model IReadOnlyList<TechnifyERP.Application.Admin.StudentListItemDto>
@{
    ViewData["Title"] = "Students";
}

<div class="mb-4">
    <h1 class="h2 mb-1">Students</h1>
    <p class="text-secondary mb-0">View registered students and their approved courses.</p>
</div>
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Registration No.</th>
                    <th>Student</th>
                    <th>Contact</th>
                    <th>Courses</th>
                    <th>Status</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center text-secondary py-5">No students found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var student in Model)
                    {
                        <tr>
                            <td><span class="badge text-bg-light border">@(student.RegistrationNumber ?? "Pending")</span></td>
                            <td><strong>@student.FullName</strong><br /><small class="text-secondary">@student.Email</small>
                            </td>
                            <td>@(student.PhoneNumber ?? "—")</td>
                            <td>@(student.Courses.Count == 0 ? "—" : string.Join(", ", student.Courses))</td>
                            <td>@student.AccountStatus</td>
                            <td class="text-end"><a asp-action="Details" asp-route-id="@student.UserId"
                                                        class="btn btn-sm btn-outline-primary">View</a></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
