@model TechnifyERP.Application.Settings.AcademySettingsDto
@{ViewData["Title"]="Academy Settings";}<h1 class="h2">Academy Settings</h1><p class="text-secondary">Institute branding aur contact information manage karein.</p>@if(TempData["SuccessMessage"] is string s){<div class="alert alert-success">@s</div>}@if(TempData["ErrorMessage"] is string e){<div class="alert alert-danger">@e</div>}<form asp-action="Save" method="post" class="card border-0 shadow-sm"><div class="card-body row g-3"><div class="col-md-6"><label>Academy Name</label><input name="academyName" value="@Model.AcademyName" class="form-control" required/></div><div class="col-md-6"><label>Short Name</label><input name="shortName" value="@Model.ShortName" class="form-control" required/></div><div class="col-md-6"><label>Website</label><input name="website" value="@Model.Website" type="url" class="form-control" placeholder="https://example.com"/></div><div class="col-md-6"><label>Academic Year</label><input name="academicYear" value="@Model.AcademicYear" class="form-control" required/></div><div class="col-md-6"><label>Email</label><input name="email" value="@Model.Email" type="email" class="form-control"/></div><div class="col-md-6"><label>Phone</label><input name="phone" value="@Model.Phone" class="form-control"/></div><div class="col-12"><label>Address</label><textarea name="address" class="form-control">@Model.Address</textarea></div><div><button class="btn btn-primary">Save Settings</button></div></div></form>
