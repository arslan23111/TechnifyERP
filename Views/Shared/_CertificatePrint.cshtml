@model TechnifyERP.Application.Certificates.CertificateDto
@{
    Layout = null;
}
<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8" />
    <title>@Model.CertificateCode</title>
    <style>
            body {
                font-family: Georgia, serif;
                background: #f3f6fb;
                margin: 0;
                padding: 30px
            }

            .certificate {
                box-sizing: border-box;
                max-width: 1050px;
                min-height: 720px;
                margin: auto;
                background: #fff;
                border: 14px solid #0d6efd;
                padding: 65px;
                text-align: center;
                position: relative
            }

            .certificate:before {
                content: "";
                position: absolute;
                inset: 12px;
                border: 2px solid #d4af37
            }

            .brand {
                color: #0d6efd;
                font-family: Arial, sans-serif;
                font-weight: bold;
                letter-spacing: 3px
            }

            .title {
                font-size: 52px;
                margin: 40px 0 12px;
                color: #1d3557
            }

            .name {
                font-size: 42px;
                color: #0d6efd;
                border-bottom: 1px solid #bbb;
                display: inline-block;
                padding: 0 50px 8px;
                margin: 20px
            }

            .course {
                font-size: 29px;
                font-weight: bold
            }

            .code {
                margin-top: 45px;
                font-family: Arial, sans-serif;
                color: #555
            }

            .footer {
                position: absolute;
                bottom: 50px;
                left: 70px;
                right: 70px;
                display: flex;
                justify-content: space-between;
                font-family: Arial, sans-serif
            }

            @@media print {
                body {
                    padding: 0;
                    background: #fff
                }

                .certificate {
                    border-width: 10px;
                    min-height: 700px
                }

                .no-print {
                    display: none
                }
            }
    </style>
</head>

<body><button class="no-print" onclick="window.print()">Print / Save as PDF</button>
    <main class="certificate">
        <div class="brand">TECHNIFY ERP</div>
        <h1 class="title">Certificate of Completion</h1>
        <p>This certificate is proudly presented to</p>
        <div class="name">@Model.StudentName</div>
        <p>for successful participation and completion of</p>
        <div class="course">@Model.CourseCode - @Model.CourseName</div>
        <p>Issued on @Model.IssueDate.ToString("dd MMMM yyyy")</p>
        <div class="code">Certificate Code: <strong>@Model.CertificateCode</strong></div>
        <div class="footer"><span>Issued by: @Model.IssuedBy</span><span>Technify ERP</span></div>
    </main>
</body>

</html>