@{
    ViewData["Title"] = "Registration Submitted";
}

<div class="row justify-content-center text-center">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-5">
                <div class="display-5 text-success mb-3">✓</div>
                <h1 class="h3">Registration submitted</h1>
                <p class="text-secondary">Your account is pending administrator approval. You will be able to sign in after approval.</p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Return Home</a>
            </div>
        </div>
    </div>
</div>
